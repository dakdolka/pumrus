# PostgreSQL
POSTGRES_DB=pumrus
POSTGRES_USER=pumrus
POSTGRES_PASSWORD=replace-with-a-long-random-password
BACKUP_RETENTION_DAYS=14

# Used when running backend or Alembic outside Docker.
DATABASE_URL=postgresql+asyncpg://pumrus:replace-me@127.0.0.1:5432/pumrus

# Required owner key for /form and every v2 admin mutation.
# Generate a long random value; do not expose it in frontend code or Git.
ADMIN_TOKEN=
BACKEND_INTERNAL_TOKEN=replace-with-another-long-random-secret
# Never enable this on an internet-facing installation.
ALLOW_INSECURE_ADMIN=false
MEDIA_ROOT=/app/media
MEDIA_MAX_BYTES=8388608
PAYMENT_MODE=disabled
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PAYMENT_RETURN_URL=https://bestgreen.ru/payment/return
PAYMENT_TERMS_URL=https://bestgreen.ru/terms
PAYMENT_SUPPORT_URL=https://t.me/dak_dolka

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=https://bestgreen.ru,https://www.bestgreen.ru,http://localhost:3000,http://127.0.0.1:3000

# Only needed while importing legacy content. Do not commit real credentials.
LEGACY_DATABASE_URL=mysql+asyncmy://legacy-user:replace-me@host.docker.internal:3306/pumrus_db

# Telegram
TOKEN=replace-with-bot-token
WEB_APP_URL=https://example.com
API_URL=http://backend:8000/api
TG_PROXY=

# Current deployment can stay on polling. Switch to "webhook" when the
# public webhook endpoint and payment flow are ready.
BOT_MODE=polling
WEBHOOK_BASE_URL=https://example.com
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=replace-with-a-long-random-secret
WEBHOOK_PORT=8080
